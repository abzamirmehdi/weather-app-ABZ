import React, { useEffect } from 'react';
import { StyleSheet, Text, View, ScrollView, Dimensions } from 'react-native';
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withTiming,
  withDelay,
  Easing,
} from 'react-native-reanimated';
import { getWeatherInfo } from '../services/weatherApi';

const { width } = Dimensions.get('window');
const days = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنجشنبه', 'جمعه', 'شنبه'];

export default function DailyForecast({ daily }) {
  const animations = Array.from({ length: 7 }, () => useSharedValue(0));

  useEffect(() => {
    animations.forEach((anim, index) => {
      anim.value = withDelay(
        index * 100,
        withTiming(1, { duration: 500, easing: Easing.out(Easing.cubic) })
      );
    });
  }, []);

  if (!daily) return null;

  const today = new Date();

  return (
    <View style={styles.container}>
      <Text style={styles.title}>پیش‌بینی ۷ روز آینده</Text>
      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        contentContainerStyle={styles.scrollContent}
      >
        {daily.time.map((date, index) => {
          const dayDate = new Date(date);
          const dayName = index === 0 ? 'امروز' : days[dayDate.getDay()];
          const info = getWeatherInfo(daily.weather_code[index]);
          const maxTemp = Math.round(daily.temperature_2m_max[index]);
          const minTemp = Math.round(daily.temperature_2m_min[index]);

          const cardStyle = useAnimatedStyle(() => ({
            opacity: animations[index].value,
            transform: [
              { translateY: (1 - animations[index].value) * 30 },
              { scale: 0.9 + animations[index].value * 0.1 },
            ],
          }));

          return (
            <Animated.View key={date} style={[styles.card, cardStyle]}>
              <Text style={styles.dayName}>{dayName}</Text>
              <Text style={styles.weatherIcon}>{info.icon}</Text>
              <Text style={styles.maxTemp}>{maxTemp}°</Text>
              <Text style={styles.minTemp}>{minTemp}°</Text>
            </Animated.View>
          );
        })}
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    marginTop: 30,
    paddingHorizontal: 20,
  },
  title: {
    fontSize: 18,
    fontWeight: 'bold',
    color: '#fff',
    marginBottom: 15,
  },
  scrollContent: {
    paddingRight: 20,
  },
  card: {
    width: 90,
    height: 140,
    backgroundColor: 'rgba(255, 255, 255, 0.15)',
    borderRadius: 20,
    marginRight: 12,
    alignItems: 'center',
    justifyContent: 'center',
    paddingVertical: 15,
    borderWidth: 1,
    borderColor: 'rgba(255, 255, 255, 0.2)',
  },
  dayName: {
    fontSize: 14,
    color: '#fff',
    fontWeight: '600',
    marginBottom: 8,
  },
  weatherIcon: {
    fontSize: 32,
    marginBottom: 8,
  },
  maxTemp: {
    fontSize: 18,
    fontWeight: 'bold',
    color: '#fff',
  },
  minTemp: {
    fontSize: 14,
    color: 'rgba(255, 255, 255, 0.7)',
    marginTop: 2,
  },
});
